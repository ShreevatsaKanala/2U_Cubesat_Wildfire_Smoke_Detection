# CubeSat Digital Twin — Environment Variables
# Copy this file to .env and fill in real values

# NASA FIRMS API Key (https://firms.modaps.eosdis.nasa.gov/api/)
NASA_FIRMS_MAP_KEY=

# Cesium Ion Token (https://cesium.com/ion/tokens)
# Must be NEXT_PUBLIC_ for client-side CesiumJS access
NEXT_PUBLIC_CESIUM_TOKEN=

# AI Vision configuration
# AI_MODE=mock  (local mock classifier, no API needed)
# AI_MODE=live  (external vision AI via OpenRouter/Groq)
AI_MODE=mock
AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# GROQ_API_KEY=gsk_...
# OPENROUTER_MODEL=google/gemini-2.0-flash-001
# GROQ_MODEL=qwen/qwen3.6-27b
AI_TIMEOUT_SECONDS=30
AI_MAX_IMAGE_MB=10
AI_IMAGE_MAX_DIMENSION=1024
AI_TEMPERATURE=0
AI_RETRY_COUNT=2
AI_FAILOVER_ENABLED=true
AI_MAX_REQUESTS_PER_MINUTE=10

# ML training pipeline (Phase 3, for future onboard deployment)
# ML_MODE=mock
# ML_MODEL_PATH=data/models/best_model.pt
# ML_SMOKE_THRESHOLD=0.5

# Open-Meteo (no key needed, base URL configurable)
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# CelesTrak (no key needed)
# CELESTRAK_BASE_URL=https://celestrak.org/NORAD/elements

# Backend
# BACKEND_HOST=0.0.0.0
# BACKEND_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
