# CubeSat Digital Twin — Environment Variables
# Copy this file to .env and fill in real values

# NASA FIRMS API Key (https://firms.modaps.eosdis.nasa.gov/api/)
NASA_FIRMS_MAP_KEY=

# Cesium Ion Token (https://cesium.com/ion/tokens)
CESIUM_ION_TOKEN=

# Open-Meteo (no key needed, base URL configurable)
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# CelesTrak (no key needed)
# CESIAK_BASE_URL=https://celestrak.org/NORAD/elements

# Backend
# BACKEND_HOST=0.0.0.0
# BACKEND_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
